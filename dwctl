#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if (( EUID != 0 )); then
  exec sudo -- "$0" "$@"
fi

source "$SCRIPT_DIR/scripts/common.sh"

usage() {
  cat <<'EOF'
Usage: ./dwctl <command>

Commands:
  start       Start the dedicated server
  stop        Stop the dedicated server
  restart     Restart the dedicated server
  status      Show systemd status and the UDP listener
  logs        Show recent service logs
  follow      Follow service logs
  update      Download and apply the latest server build
  password    Print the local private-world password
  paths       Show relevant installation paths
EOF
}

command_name=${1:-help}

case "$command_name" in
  start|stop|restart)
    systemctl "$command_name" "$DW_SERVICE_NAME"
    ;;
  status)
    port="$(configured_port)"
    systemctl --no-pager --full status "$DW_SERVICE_NAME"
    ss -H -lun | awk -v port="$port" '$4 ~ (":" port "$")'
    ;;
  logs)
    journalctl -u "$DW_SERVICE_NAME" -n 200 --no-pager
    ;;
  follow)
    exec journalctl -u "$DW_SERVICE_NAME" -f
    ;;
  update)
    exec "$SCRIPT_DIR/update.sh"
    ;;
  password)
    [[ -r "$DW_PASSWORD_FILE" ]] || die "Password file is missing: $DW_PASSWORD_FILE"
    cat "$DW_PASSWORD_FILE"
    ;;
  paths)
    printf 'Installation: %s\n' "$DW_INSTALL_DIR"
    printf 'World data:   %s\n' "$DW_GAME_SAVED_DIR"
    printf 'Config:       %s\n' "$DW_SERVER_CONFIG"
    printf 'Logs:         %s\n' "$DW_GAME_SAVED_DIR/Logs"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    die "Unknown command: $command_name"
    ;;
esac
